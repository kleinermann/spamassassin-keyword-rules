#!/usr/bin/env python3
"""
sa-keyword-rules – build SpamAssassin local_rules.cf from plain word lists.

Copyright (c) 2026 Stefan Ehrenfeld (https://kleinermann.com.au)
MIT License – https://github.com/kleinermann/spamassassin-keyword-rules

  Lists:     <base>/lists/*.txt              (one word/phrase per line)
  Template:  <base>/local_rules.template     (rules + scores)
  Output:    /etc/spamassassin/local_rules.cf

  <base> is, in order:
    1. $SPAM_RULES_DIR, if set
    2. the folder this script lives in (symlinks followed), if it contains
       local_rules.template
    3. /root/spamassassin-keyword-rules
  The output path can be changed with $SPAM_RULES_OUT.

List line format:
  free money            plain phrase: case-insensitive, any spacing,
                        ' and ’ both match, "quotes" optional,
                        hyphens match hyphen/space/nothing
  # comment             ignored (blank lines too)
  re:\bbacklinks?\b     raw Perl regex for advanced cases

Sender lists (senders-*.txt):
  example.com           domain -> *@example.com
  @example.com          -> *@example.com
  jane@example.com      single address
  *@*.xyz               wildcards kept as written

Usage:
  sa-keyword-rules           build, lint, install, restart spamd
  sa-keyword-rules --dry     build and lint only, show stats, change nothing
"""
import os, re, shutil, subprocess, sys

def _base_dir():
    if os.environ.get("SPAM_RULES_DIR"):
        return os.environ["SPAM_RULES_DIR"]
    here = os.path.dirname(os.path.realpath(__file__))
    if os.path.exists(os.path.join(here, "local_rules.template")):
        return here
    return "/root/spamassassin-keyword-rules"

BASE     = _base_dir()
LISTS    = os.path.join(BASE, "lists")
TEMPLATE = os.path.join(BASE, "local_rules.template")
OUTPUT   = os.environ.get("SPAM_RULES_OUT", "/etc/spamassassin/local_rules.cf")

APOS  = r"(?:\x27|\xe2\x80\x99)"                      # apostrophe, straight or curly
QUOTE = r'(?:"|\xe2\x80[\x9c\x9d])?'              # optional straight or curly double quote
NEVER = r"(?!x)x"                                    # matches nothing

def read_list(name):
    path = os.path.join(LISTS, name)
    if not os.path.exists(path):
        sys.exit(f"ERROR: list file missing: {path}")
    seen, out = set(), []
    with open(path, encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            key = line.lower()
            if key not in seen:
                seen.add(key)
                out.append(line)
    return out

def esc_char(c):
    if c.isascii():
        return c if (c.isalnum() or c == "_") else "\\" + c
    return "".join(f"\\x{b:02x}" for b in c.encode("utf-8"))  # match UTF-8 octets

def phrase_to_regex(p):
    if p.startswith("re:"):
        return "(?:" + p[3:].strip() + ")"
    p = p.strip().strip(".,!;:")        # pasted sentence punctuation
    out, prev_space = [], False
    for c in p:
        if c.isspace():
            if not prev_space:
                out.append(r"\s+")
            prev_space = True
            continue
        prev_space = False
        if c in "'’":
            out.append(APOS)
        elif c in '"“”':
            out.append(QUOTE)
        elif c == "-":
            out.append(r"[\s-]?")
        else:
            out.append(esc_char(c))
    body = "".join(out)
    word = lambda ch: ch.isalnum() or ch == "_"
    core = p.replace('"', "").replace("“", "").replace("”", "")
    pre  = r"\b" if core and word(core[0]) else ""
    post = r"\b" if core and word(core[-1]) else ""
    return pre + body + post

def domain_to_regex(d):
    if d.startswith("re:"):
        return "(?:" + d[3:].strip() + ")"
    m = re.search(r"\((https?://[^)]+)\)", d)          # markdown [x](url)
    if m:
        d = m.group(1)
    d = re.sub(r"^[a-z]+://", "", d.strip().strip("[]<>"), flags=re.I)
    d = re.sub(r"^www\.", "", d, flags=re.I)
    d = d.split("/")[0].strip(".").lower()
    return "".join(esc_char(c) for c in d)

SENDER_DIRECTIVES = {"welcomelist_auth", "welcomelist_from", "blocklist_from",
                     "whitelist_auth", "whitelist_from", "blacklist_from"}

def sender_entries(line):
    """One list line -> list of sender patterns (spaces/commas split)."""
    out = []
    for s in re.split(r"[\s,;]+", line.strip()):
        s = s.strip().strip("<>").lower()
        if s.startswith("mailto:"):
            s = s[7:]
        if not s:
            continue
        if "@" not in s:
            s = "*@" + s
        elif s.startswith("@"):
            s = "*" + s
        if not re.fullmatch(r"[a-z0-9*._%+\-]+@[a-z0-9*.\-]+", s):
            sys.exit(f"ERROR: invalid sender entry: {line.strip()!r}")
        out.append(s)
    return out

def build():
    with open(TEMPLATE, encoding="utf-8") as f:
        tpl = f.read()
    stats = {}
    def sub(m):
        kind, name = m.group(1), m.group(2)
        items = read_list(name)
        conv = domain_to_regex if kind == "domains" else phrase_to_regex
        stats[name] = len(items)
        return "|".join(conv(i) for i in items) or NEVER
    def sub_senders(m):
        directive, name = m.group(1), m.group(2)
        if directive not in SENDER_DIRECTIVES:
            sys.exit(f"ERROR: unknown sender directive in template: {directive}")
        seen, lines = set(), []
        for item in read_list(name):
            for e in sender_entries(item):
                if e not in seen:
                    seen.add(e)
                    lines.append(f"{directive:<18}{e}")
        stats[name] = len(lines)
        return "\n".join(lines) or f"# ({name} is empty)"

    out = re.sub(r"\{\{senders:(\w+):([\w.-]+)\}\}", sub_senders, tpl)
    out = re.sub(r"\{\{(list|domains):([\w.-]+)\}\}", sub, out)
    return out, stats

def lint():
    r = subprocess.run(["spamassassin", "--lint"], capture_output=True, text=True)
    return r.returncode == 0, (r.stdout + r.stderr).strip()

def restart():
    for svc in ("spamd", "spamassassin"):
        if subprocess.run(["systemctl", "restart", svc],
                          capture_output=True).returncode == 0:
            return svc
    return None

def main():
    if "-h" in sys.argv or "--help" in sys.argv:
        print(__doc__)
        return
    dry = "--dry" in sys.argv
    print(f"Source: {BASE}\nOutput: {OUTPUT}\n")
    text, stats = build()
    for n, c in sorted(stats.items()):
        print(f"  {n:<26} {c:>4} entries")

    backup = OUTPUT + ".bak"
    had_old = os.path.exists(OUTPUT)
    if had_old:
        shutil.copy2(OUTPUT, backup)

    with open(OUTPUT, "w", encoding="utf-8") as f:
        f.write(text)
    ok, msg = lint()

    if not ok or dry:
        if had_old:
            shutil.copy2(backup, OUTPUT)
        else:
            os.remove(OUTPUT)
    if not ok:
        print("\nLINT FAILED – previous rules restored, nothing changed:\n")
        print(msg)
        sys.exit(1)
    if dry:
        print("\nLint OK (dry run – nothing installed).")
        return

    svc = restart()
    print(f"\nLint OK – installed {OUTPUT}" +
          (f", restarted {svc}." if svc else ", but could not restart spamd!"))

if __name__ == "__main__":
    main()
